# Скопировать в .env и заполнить реальными значениями. .env в .gitignore, не коммитить.

# Metabase (https://metabase.scope360.io) — Settings → Admin → API Keys
METABASE_URL=https://metabase.scope360.io
METABASE_API_KEY=

# Google Analytics 4 — Data API. Нужен также файл ga4-service-account.json
# (сервис-аккаунт с ролью Viewer в обоих GA4-свойствах ниже), в .gitignore.
GA4_PROPERTY_ID=          # scope360.io — лендинг до логина
GA4_PROPERTY_ID_APP=      # scope360.io/futures — приложение после логина

# Meta Marketing API (Facebook/Instagram Ads) — System User token с правами
# ads_read на рекламном аккаунте ниже.
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=       # формат act_XXXXXXXXXX
